{%- comment -%}
  Divas Care — "What is Divas Care?" intro section
  Matches the React app's welcome-strip design.
{%- endcomment -%}

<section class="divas-intro-section index-section" data-section-id="{{ section.id }}" data-section-type="divas-intro">
  <div class="page-width">
    <div class="divas-intro__grid">
      <div class="divas-intro__heading-column">
        {%- if section.settings.eyebrow != blank -%}
          <p class="divas-intro__eyebrow">{{ section.settings.eyebrow | escape }}</p>
        {%- endif -%}
        {%- if section.settings.title != blank -%}
          <h2 class="divas-intro__heading">{{ section.settings.title | escape }}</h2>
        {%- endif -%}
      </div>

      <div class="divas-intro__text-column">
        {%- if section.settings.text != blank -%}
          <div class="divas-intro__text rte">{{ section.settings.text }}</div>
        {%- endif -%}
      </div>
    </div>
  </div>
</section>

<style>
  .divas-intro-section {
    background: var(--divas-bg, #1e1229);
    border-bottom: 1px solid var(--divas-line, rgba(215, 185, 229, 0.18));
    padding: 54px 24px 34px;
  }

  .divas-intro-section .page-width {
    max-width: 1100px;
    margin: 0 auto;
  }

  .divas-intro__grid {
    display: grid;
    grid-template-columns: 1fr;
    gap: 30px;
    align-items: baseline;
  }

  .divas-intro__eyebrow {
    color: var(--divas-text-label, #d7b9e5);
    font-family: var(--divas-font, 'Poppins', sans-serif);
    font-size: 12px;
    font-weight: 700;
    letter-spacing: 0.18em;
    text-transform: uppercase;
    margin: 0 0 16px;
  }

  .divas-intro__heading {
    color: var(--divas-text-primary, #fffaf5);
    font-family: var(--divas-font, 'Poppins', sans-serif);
    font-size: clamp(32px, 4vw, 58px);
    font-weight: 600;
    line-height: 0.98;
    max-width: 360px;
    margin: 0;
  }

  .divas-intro__text {
    color: var(--divas-text-body, #ead9f2);
    font-family: var(--divas-font, 'Poppins', sans-serif);
    font-size: clamp(24px, 3vw, 40px);
    line-height: 1.12;
    max-width: 660px;
  }

  .divas-intro__text p {
    margin: 0;
  }

  @media screen and (min-width: 750px) {
    .divas-intro__grid {
      grid-template-columns: 0.7fr 1.3fr;
    }
  }
</style>

{% schema %}
{
  "name": "Divas Intro",
  "class": "index-section",
  "settings": [
    {
      "type": "text",
      "id": "eyebrow",
      "label": "Eyebrow label",
      "default": "What is Divas Care?"
    },
    {
      "type": "text",
      "id": "title",
      "label": "Heading",
      "default": "Care that moves with you."
    },
    {
      "type": "richtext",
      "id": "text",
      "label": "Text",
      "default": "<p>We bring calm, confidence, and expert post-op support to the moments that matter most. Your transformation deserves to feel just as good as it looks.</p>"
    }
  ],
  "presets": [
    {
      "name": "Divas Intro",
      "category": "Text"
    }
  ]
}
{% endschema %}
